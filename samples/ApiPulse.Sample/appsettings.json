{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Every ApiPulse setting with its built-in default, so each one can be tuned here. Only ServiceName and the extra entries
  // of MaskBodyFields / MaskHeaders differ from the defaults. All of this is optional: AddApiPulse() works with no section at all.
  //
  // "null" means "not set / automatic". List settings are appended to the built-in lists, so the entries below are already
  // active whether or not they are written here; repeating them is harmless. To remove a default, clear the list in code:
  // AddApiPulse(o => o.MaskHeaders.Clear()).
  "ApiPulse": {
    // ------------------------------------------------------------ general
    "Enabled": true,                       // master switch, can be flipped at runtime
    "ApiKey": null,                        // sent as X-Api-Key to Endpoint
    "Endpoint": null,                      // ingest URL; null = nothing exported (the dashboard still works)
    "ServiceName": "boundless-bookstore",  // default: the host application name
    "ServiceVersion": null,                // default: entry assembly informational version
    "EnvironmentName": null,               // default: the hosting environment name
    "AutoRegisterMiddleware": true,        // false = call app.UseApiPulse() yourself

    // ------------------------------------------------------------ dashboard (Development only unless Authorize is set in code)
    "Dashboard": {
      "Enabled": true,
      "Path": "/apipulse",
      "MaxEntries": 1000                   // allowed range 10 - 100000
    },

    // ------------------------------------------------------------ capture
    "CaptureRequestHeaders": true,
    "CaptureResponseHeaders": true,
    "CaptureQueryString": true,
    "CaptureRequestBody": null,            // null = automatic: on in Development with the dashboard, off elsewhere
    "CaptureResponseBody": null,           // same rule
    "CaptureOutgoingBodies": null,         // bodies of outgoing IHttpClientFactory calls, same rule
    "MaxBodySize": 32768,                  // bytes, per body
    "BodyContentTypes": [
      "application/json", "application/*+json", "application/xml", "application/*+xml",
      "text/*", "application/x-www-form-urlencoded"
    ],
    "ClientIp": "Full",                    // Full | Anonymized | None

    // ------------------------------------------------------------ logs
    "CaptureLogs": true,
    "MinimumLogLevel": "Information",
    "MaxLogsPerRequest": 100,
    "MaxLogMessageLength": 4096,

    // ------------------------------------------------------------ traces
    "CaptureSpans": true,
    "SpanSources": [ "System.Net.Http", "OpenTelemetry.Instrumentation.*", "Npgsql", "Microsoft.EntityFrameworkCore" ],
    "MaxSpansPerRequest": 50,

    // ------------------------------------------------------------ filtering
    "ExcludedPaths": [
      "/health", "/health/*", "/healthz", "/healthz/*", "/ready", "/readyz", "/live", "/livez", "/alive",
      "/metrics", "/favicon.ico", "/robots.txt", "/swagger/*", "/openapi/*", "/scalar/*"
    ],
    "ExcludedMethods": [],

    // ------------------------------------------------------------ sampling
    "SamplingRate": 1.0,                   // 0 - 1, fraction of requests captured in full
    "AlwaysCaptureErrors": true,           // keep 5xx / exceptions even when not sampled
    "SlowRequestThreshold": null,          // e.g. "00:00:02"; null = disabled

    // ------------------------------------------------------------ masking
    "MaskValue": "******",
    "MaskHeaders": [
      "Authorization", "Proxy-Authorization", "Cookie", "Set-Cookie", "X-Api-Key", "X-Auth-Token",
      "X-Csrf-Token", "X-Xsrf-Token", "*secret*", "*password*", "*token*", "*api-key*", "*apikey*",
      "X-Partner-Secret"                   // sample addition
    ],
    "MaskQueryParams": [
      "*token*", "*password*", "*passwd*", "pwd", "*secret*", "*api_key*", "*apikey*", "*api-key*",
      "key", "code", "sig", "signature", "auth*", "session*"
    ],
    "MaskBodyFields": [
      "*password*", "*passwd*", "pwd", "*secret*", "*token*", "*api_key*", "*apikey*", "*api-key*",
      "authorization", "*card*number*", "cardnumber", "cvv", "cvc", "*cvv*", "ssn", "*social*security*",
      "pin", "otp", "*private*key*",
      "isbn"                               // sample addition
    ],
    "MaskValuePatterns": [
      "(?i)\\bBearer\\s+[A-Za-z0-9\\-._~+/]+=*",
      "\\beyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]*"
    ],

    // ------------------------------------------------------------ consumers
    "AutoDetectConsumer": true,

    // ------------------------------------------------------------ export
    "MaxQueueSize": 10000,
    "BatchSize": 100,
    "FlushInterval": "00:00:05",
    "ExportTimeout": "00:00:10",
    "MaxRetries": 3,
    "ShutdownTimeout": "00:00:05",
    "CompressPayloads": true,
    "LogEvents": true
  }
}
